# LLM Provider: gemini (Google AI Studio) or anthropic
LLM_PROVIDER=gemini
# Google AI Studio API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ESCALATE_MODEL=gemini-2.5-pro

# Anthropic Claude API Key (optional if using Gemini)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_ESCALATE_MODEL=claude-sonnet-5

# Pipeline Settings
MAX_SEGMENTS=20
REANCHOR_CHARS=
SEGMENTER_ENGINE=crfcut

# TTS & RVC Settings
TTS_ENGINE=gemini_instruction
RVC_MODELS_DIR=models/rvc
RVC_REF_DIR=ref
RVC_CACHE_DIR=voice_cache
RVC_DEVICE=
RVC_DEFAULT_PITCH=0
RVC_DEFAULT_INDEX_RATE=0.75
RVC_DEFAULT_F0_METHOD=rmvpe
